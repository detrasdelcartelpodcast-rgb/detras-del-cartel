# Copiá este archivo como .env.local y completá los valores.
# .env.local NUNCA se sube al repositorio (está en .gitignore).
# En producción, estos valores van en Vercel → Settings → Environment Variables.

# ── Supabase (proyecto PROPIO del podcast: detras-del-cartel) ────────────────

# Dirección del proyecto. No es secreta.
VITE_SUPABASE_URL=https://wdvvsrikmyorfiimqrkk.supabase.co

# Clave "publishable" (antes se llamaba anon). Va al navegador: es pública a propósito.
# Lo que impide que alguien la use para leer datos es RLS, no que esté escondida.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Clave "secret" (antes service_role). SALTEA RLS: puede leer y escribir TODO.
# Solo el servidor. Nunca en el navegador, nunca en el repositorio, nunca en el chat.
SUPABASE_SECRET_KEY=sb_secret_...

# ── YouTube (ya existente) ──────────────────────────────────────────────────
YOUTUBE_API_KEY=
